{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/BarbTurnip437/journal-export-schema/refs/heads/main/export_data.schema.json",
  "title": "Journal Export Protocol",
  "type": "object",
  "properties": {
    "implementation": {
      "description": "This key is extra added to store the meta implementation data",
      "type": "object",
      "required": ["version"],
      "properties": {
        "version": {
          "description": "A semantic version that indicates the protocol version that the implementation used",
          "$ref": "#/$defs/version"
        }
      }
    },
    "experiences": {
      "type": "array",
      "items": { "$ref": "#/$defs/experienceSerializable" }
    },
    "substanceCompanions": {
      "type": "array",
      "items": { "$ref": "#/$defs/substanceCompanion" }
    },
    "customSubstances": {
      "type": "array",
      "items": { "$ref": "#/$defs/customSubstance" }
    },
    "customUnits": {
      "type": "array",
      "items": { "$ref": "#/$defs/customUnitSerializable" }
    }
  },
  "$defs": {
    "version": { "type": "string", "const": "0.1.0-indev" },
    "experienceSerializable": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "text": { "type": "string" },
        "creationDate": { "$ref": "#/$defs/unixTimestamp" },
        "sortDate": { "$ref": "#/$defs/unixTimestamp" },
        "isFavorite": { "type": "boolean" },
        "ingestions": {
          "type": "array",
          "items": { "$ref": "#/$defs/ingestionSerializable" }
        },
        "location": {
          "anyOf": [
            { "$ref": "#/$defs/locationSerializable" },
            { "type": "null" }
          ]
        },
        "ratings": {
          "type": "array",
          "items": { "$ref": "#/$defs/ratingSerializable" }
        },
        "timedNotes": {
          "type": "array",
          "items": { "$ref": "#/$defs/timedNoteSerializable" }
        }
      },
      "required": ["title", "text", "sortDate", "location", "isFavorite"]
    },
    "customUnitSerializable": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "substanceName": { "type": "string" },
        "name": { "type": "string" },
        "creationDate": { "$ref": "#/$defs/unixTimestamp" },
        "administrationRoute": { "$ref": "#/$defs/administrationRoute" },
        "dose": { "type": ["number", "null"] },
        "estimatedDoseStandardDeviation": { "type": ["number", "null"] },
        "isEstimate": { "type": "boolean" },
        "isArchived": { "type": "boolean" },
        "unit": { "type": "string" },
        "unitPlural": { "type": ["string", "null"] },
        "originalUnit": { "type": "string" },
        "note": { "type": "string" }
      },
      "required": [
        "substanceName",
        "name",
        "administrationRoute",
        "isEstimate",
        "isArchived",
        "unit",
        "originalUnit",
        "note"
      ]
    },
    "ratingSerializable": {
      "type": "object",
      "properties": {
        "option": { "$ref": "#/$defs/shulginRatingOption" },
        "time": { "$ref": "#/$defs/optionalUnixTimestamp" },
        "creationDate": { "$ref": "#/$defs/optionalUnixTimestamp" }
      },
      "required": ["option"]
    },
    "ingestionSerializable": {
      "type": "object",
      "properties": {
        "substanceName": { "type": "string" },
        "time": { "$ref": "#/$defs/unixTimestamp" },
        "endTime": { "$ref": "#/$defs/optionalUnixTimestamp" },
        "creationDate": {
          "type": ["integer", "null"],
          "$ref": "#/$defs/unixTimestamp"
        },
        "administrationRoute": { "$ref": "#/$defs/administrationRoute" },
        "dose": { "type": ["number", "null"] },
        "isDoseAnEstimate": { "type": "boolean" },
        "estimatedDoseStandardDeviation": { "type": ["number", "null"] },
        "units": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] },
        "stomachFullness": {
          "anyOf": [{ "$ref": "#/$defs/stomachFullness" }, { "type": "null" }]
        },
        "consumerName": { "type": ["string", "null"] },
        "customUnitId": { "$ref": "#/$defs/optionalUnixTimestamp" }
      },
      "required": [
        "substanceName",
        "time",
        "administrationRoute",
        "isDoseAnEstimate"
      ]
    },
    "locationSerializable": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "latitude": { "type": ["number", "null"] },
        "longitude": { "type": ["number", "null"] }
      },
      "required": ["name"]
    },
    "timedNoteSerializable": {
      "type": "object",
      "properties": {
        "creationDate": { "$ref": "#/$defs/unixTimestamp" },
        "time": { "$ref": "#/$defs/unixTimestamp" },
        "note": { "type": "string" },
        "color": { "$ref": "#/$defs/adaptiveColor" },
        "isPartOfTimeline": { "type": "boolean" }
      },
      "required": ["creationDate", "time", "note", "color", "isPartOfTimeline"]
    },
    "substanceCompanion": {
      "type": "object",
      "properties": {
        "substanceName": { "type": "string" },
        "color": { "$ref": "#/$defs/adaptiveColor" }
      },
      "required": ["substanceName", "color"]
    },
    "customSubstance": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" },
        "units": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["name", "units", "description"]
    },
    "administrationRoute": {
      "type": "string",
      "enum": [
        "ORAL",
        "SUBLINGUAL",
        "BUCCAL",
        "INSUFFLATED",
        "RECTAL",
        "TRANSDERMAL",
        "SUBCUTANEOUS",
        "INTRAMUSCULAR",
        "INTRAVENOUS",
        "SMOKED",
        "INHALED"
      ]
    },
    "stomachFullness": {
      "type": "string",
      "enum": ["EMPTY", "QUARTERFULL", "HALFFULL", "FULL", "VERYFULL"]
    },
    "shulginRatingOption": {
      "type": "string",
      "enum": ["minus", "plusMinus", "plus", "twoPlus", "threePlus", "fourPlus"]
    },
    "adaptiveColor": {
      "type": "string",
      "enum": [
        "RED",
        "ORANGE",
        "YELLOW",
        "GREEN",
        "MINT",
        "TEAL",
        "CYAN",
        "BLUE",
        "INDIGO",
        "PURPLE",
        "PINK",
        "BROWN",
        "FIRE_ENGINE_RED",
        "CORAL",
        "TOMATO",
        "CINNABAR",
        "RUST",
        "ORANGE_RED",
        "AUBURN",
        "SADDLE_BROWN",
        "DARK_ORANGE",
        "DARK_GOLD",
        "KHAKI",
        "BRONZE",
        "GOLD",
        "OLIVE",
        "OLIVE_DRAB",
        "DARK_OLIVE_GREEN",
        "MOSS_GREEN",
        "LIME_GREEN",
        "LIME",
        "FOREST_GREEN",
        "SEA_GREEN",
        "JUNGLE_GREEN",
        "LIGHT_SEA_GREEN",
        "DARK_TURQUOISE",
        "DODGER_BLUE",
        "ROYAL_BLUE",
        "DEEP_LAVENDER",
        "BLUE_VIOLET",
        "DARK_VIOLET",
        "HELIOTROPE",
        "BYZANTIUM",
        "MAGENTA",
        "DARK_MAGENTA",
        "FUCHSIA",
        "DEEP_PINK",
        "GRAYISH_MAGENTA",
        "HOT_PINK",
        "JAZZBERRY_JAM",
        "MAROON"
      ]
    },
    "unixTimestamp": {
      "type": "integer",
      "description": "Unix timestamp in milliseconds since epoch"
    },
    "optionalUnixTimestamp": {
      "type": ["integer", "null"],
      "description": "Optional unix timestamp in milliseconds since epoch"
    }
  }
}
